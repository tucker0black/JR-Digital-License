# Copy this file to a private VPS-only environment file and replace every
# placeholder. Do not commit the private file.

NODE_ENV=production
APP_URL=https://jrdigitallicense.win
MINIAPP_URL=https://jrdigitallicense.win
API_URL=http://api:4000
CORS_ORIGINS=https://jrdigitallicense.win
PORT=4000
HOST=0.0.0.0

# Development authentication must remain disabled in production.
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_DEV_AUTH_ENABLED=false
DEV_AUTH_TELEGRAM_ID=

POSTGRES_DB=jr_digital_license
POSTGRES_USER=jr
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql://jr:replace-with-a-strong-postgres-password@postgres:5432/jr_digital_license?schema=public

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379

TELEGRAM_BOT_TOKEN=replace-with-the-existing-bot-token
TELEGRAM_BOT_USERNAME=jrdigitallicense_bot
TELEGRAM_ADMIN_GROUP_ID=
BOT_SECRET=replace-with-the-existing-bot-api-secret

# Keep the existing value exactly when moving the current database.
INVENTORY_ENCRYPTION_KEY=replace-with-the-existing-inventory-encryption-key
SESSION_SECRET=replace-with-a-stable-random-session-secret

WORKER_INTERVAL_MS=60000
PAYMENT_EXPIRATION_MINUTES=15
MEDIA_STORAGE_DIR=/app/apps/api/uploads/media

BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=replace-with-the-production-bakong-token
BAKONG_ACCOUNT_ID=replace-with-the-kyc-verified-bakong-account-id
BAKONG_MERCHANT_NAME=Rotha Jim
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_STORE_LABEL=JR Digital License
BAKONG_TERMINAL_LABEL=JR-DIGITAL-LICENSE

# ABA PayWay payment gateway (used for product/order payments).
# Wallet deposits use KHQRCC (see KHQRCC_* variables above).
# Sandbox: https://checkout-sandbox.payway.com.kh
# Production: https://checkout.payway.com.kh
ABA_PAYWAY_ENVIRONMENT=production
ABA_PAYWAY_MERCHANT_ID=replace-with-the-payway-merchant-id
ABA_PAYWAY_API_KEY=replace-with-the-payway-api-key
ABA_PAYWAY_API_URL=https://checkout.payway.com.kh
ABA_PAYWAY_CALLBACK_URL=https://api.jrdigitalllicense.win/api/payments/webhook/payway
ABA_PAYWAY_WEBHOOK_URL=https://api.jrdigitalllicense.win/api/payments/webhook/payway

# Optional SMM provider settings.
SMM_API_URL=
SMM_API_KEY=

NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=
TOPUP_VERIFICATION_TTL_MINUTES=10
SUPPORT_OPEN_TIME=09:00
SUPPORT_CLOSE_TIME=17:00
SUPPORT_TIMEZONE_OFFSET_MINUTES=0

# Initial admin bootstrap only. Do not regenerate the admin token during a
# database migration unless an intentional admin-token reset is required.
ADMIN_TELEGRAM_ID=replace-with-the-admin-telegram-id
ADMIN_FIRST_NAME=JR
ADMIN_LAST_NAME=
ADMIN_USERNAME=
ADMIN_API_TOKEN=replace-with-the-existing-or-new-admin-api-token

# Existing named Cloudflare Tunnel token. This is consumed only by the
# cloudflared Compose service and must never be committed.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-existing-named-tunnel-token

# The current bot uses long polling, so no webhook secret is required.
TELEGRAM_WEBHOOK_SECRET=
