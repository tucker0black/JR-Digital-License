{
  "name": "@jr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json && node --env-file=../../.env --watch dist/index.js",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "npm run build && node --env-file=../../.env dist/scripts/seed.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@jr/shared": "workspace:*",
    "@prisma/client": "^6.4.1",
    "bakong-khqr": "^1.0.20",
    "bullmq": "^5.40.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.4.1"
  }
}
