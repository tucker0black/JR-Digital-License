NODE_ENV=development
APP_URL=http://localhost:3001
# Mini App URL used by the Telegram bot's "Open Mini App" button and chat menu button.
# Must be HTTPS in production (Telegram requires HTTPS for Web Apps), e.g. https://xxxxx.ngrok-free.app
MINIAPP_URL=http://localhost:3001
API_URL=http://localhost:4000
# Browser origins allowed to call the API (comma-separated). Empty = CORS disabled.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Development-only auth (NEVER enabled in production):
# Backend exposes POST /api/dev/auth when NODE_ENV != production and DEV_AUTH_ENABLED=true.
# Frontend uses it when NEXT_PUBLIC_DEV_AUTH_ENABLED=true (browser only).
# DEV_AUTH_TELEGRAM_ID falls back to ADMIN_TELEGRAM_ID, then 999000001.
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_DEV_AUTH_ENABLED=false
DEV_AUTH_TELEGRAM_ID=

DATABASE_URL=postgresql://jr:jr_local_password@localhost:5432/jr_digital_license?schema=public
REDIS_URL=redis://localhost:6379

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=jrdigitallicense_bot
TELEGRAM_WEBHOOK_SECRET=
# Telegram group chat ID where paid-order notifications are sent (leave empty to disable).
TELEGRAM_ADMIN_GROUP_ID=

SESSION_SECRET=
INVENTORY_ENCRYPTION_KEY=

# Shared secret used by the Telegram bot to call internal API endpoints
# (GET /api/internal/bot/:telegramId/balance and /orders).
BOT_SECRET=

# Background worker tuning (API process):
# WORKER_INTERVAL_MS: how often the payment-expiration sweep runs (0 disables it).
# PAYMENT_EXPIRATION_MINUTES: age after which PENDING payment sessions are expired.
WORKER_INTERVAL_MS=60000
PAYMENT_EXPIRATION_MINUTES=15

# Permanent storage directory for admin-uploaded images (game logos, banner
# artwork). Files here are application-owned and NEVER expire or get removed
# automatically. Default: apps/api/uploads/media. Back this directory up.
MEDIA_STORAGE_DIR=


# Admin dashboard bootstrap (used by `pnpm --filter @jr/api db:seed`)
# ADMIN_API_TOKEN may be left empty to generate a random token, printed once.
ADMIN_TELEGRAM_ID=
ADMIN_FIRST_NAME=JR
ADMIN_LAST_NAME=
ADMIN_USERNAME=
ADMIN_API_TOKEN=

# Bakong API base URL (legacy — kept for historical payment verification only).
# Official production: https://api-bakong.nbc.gov.kh
# Bakong Relay for RBK tokens: https://api.bakongrelay.com
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=Rotha Jim
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_STORE_LABEL=JR Digital License
BAKONG_TERMINAL_LABEL=JR-DIGITAL-LICENSE

# ABA PayWay payment gateway (primary payment provider for new transactions).
# Sandbox: https://checkout-sandbox.payway.com.kh
# Production: https://checkout.payway.com.kh
ABA_PAYWAY_ENVIRONMENT=sandbox
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_API_URL=
# Optional callback URL for PayWay QR API (Base64-encoded in requests)
ABA_PAYWAY_CALLBACK_URL=
# ABA PayWay webhook URL — configure this in your PayWay merchant dashboard.
# Example: https://yourdomain.com/api/payments/webhook/payway
ABA_PAYWAY_WEBHOOK_URL=

SMM_API_URL=
SMM_API_KEY=

# Volsever Game ID Checker (verification-only provider for account validation).
# Does NOT handle top-up orders — FazerCards handles ordering.
# Get your API key at https://dashboard.volsever.com (Free tier available for testing).
VOLSEVER_API_KEY=

# Telegram support destination shown in the Mini App (e.g. https://t.me/myusername or https://t.me/my_support_bot). Leave empty to hide the external support link.
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=

# Top-up account verification (optional; default 10 minutes)
TOPUP_VERIFICATION_TTL_MINUTES=10

